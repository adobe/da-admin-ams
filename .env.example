# Example environment configuration for da-admin-ams tests
# Copy this file to .env and customize for your environment

# Domain configuration (defaults match gov-stage)
# DA_DOMAIN=ssa-da.live
# DA_COLLAB=stg-collab.ssa-da.live
# HLX_PROD_SERVER_HOST_PAGE=gov-aem.page
# HLX_PROD_SERVER_HOST_LIVE=gov-aem.live
# AEM_BUCKET_NAME=aem-content-stage
# CF_ACCOUNT_ID=980b8b7745c7f2165f369b9d6f3c61f5

# For ent-aem environment testing:
# DA_DOMAIN=ent-da.live
# DA_COLLAB=collab.ent-da.live
# HLX_PROD_SERVER_HOST_PAGE=ent-aem.page
# HLX_PROD_SERVER_HOST_LIVE=ent-aem.live
# AEM_BUCKET_NAME=aem-content-ent
# CF_ACCOUNT_ID=ff68e0f71563bc546fedcfda6bd8e5ca

# Secrets (only needed if testing against real services)
# S3_ACCESS_KEY_ID=your-key-here
# S3_SECRET_ACCESS_KEY=your-secret-here
# IMS_ORIGIN=https://ims-na1.adobelogin.com # To do: replace with Okta when ready
